# ============================================================================
# Backend environment - copy to .env and fill with real values.
# NEVER commit the real .env file.
# ============================================================================

# --- Core ---------------------------------------------------------------
NODE_ENV=development
PORT=4000

# --- Supabase (create a project at https://supabase.com) ----------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # server only - never expose to the browser

# Optional - only if you use a direct Postgres connection elsewhere:
# DATABASE_URL=postgresql://postgres:password@db.yourproject.supabase.co:5432/postgres

# --- App ----------------------------------------------------------------
APP_NAME=M&E Document Hub
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
MAX_FILE_SIZE_MB=25
BUCKET_NAME=documents
MAX_BUCKET_SIZE_MB=5120

# --- Email notifications (Resend) ---------------------------------------
# https://resend.com - create an API key; EMAIL_FROM domain must be verified.
EMAIL_API_KEY=
EMAIL_FROM=M&E Document Hub <onboarding@resend.dev>

# --- Optional SMTP alternative (used when EMAIL_API_KEY is empty) -------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- First-run admin bootstrap (optional) -------------------------------
# Creates the first admin automatically on first boot when no admin exists.
SETUP_ADMIN_EMAIL=
SETUP_ADMIN_PASSWORD=